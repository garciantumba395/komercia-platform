# Image TOUT-EN-UN pour TESTER Komersia en ligne sur un hébergeur gratuit (Render, Koyeb, Fly, Hugging Face Spaces...).
# PostgreSQL + application dans un seul conteneur. DONNÉES ÉPHÉMÈRES : réinitialisées (données de démo) à chaque
# redémarrage. Ne JAMAIS y saisir de vraies données de clients. Production : voir docs/adr/0002.
FROM python:3.13-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends postgresql postgresql-client gosu \
    && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.8.22 /uv /uvx /usr/local/bin/

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv PATH="/opt/venv/bin:$PATH"

WORKDIR /app
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY backend/ .
COPY scripts/db-init.sql /opt/komersia/db-init.sql
COPY scripts/test-entrypoint.sh /opt/komersia/entrypoint.sh
RUN chmod +x /opt/komersia/entrypoint.sh \
    && DJANGO_SECRET_KEY=build-only DJANGO_DEBUG=0 python manage.py collectstatic --noinput \
    && chmod -R a+rX /app /opt/venv

ENV PORT=10000
EXPOSE 10000
CMD ["/opt/komersia/entrypoint.sh"]
