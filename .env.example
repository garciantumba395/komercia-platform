# Variables d'environnement de Komersia : valeurs FACTICES de DÉVELOPPEMENT uniquement.
# Copier vers .env (ignoré par git) : cp .env.example .env
# Ne JAMAIS réutiliser ces valeurs en test ou en production.

# --- Django ---
# Clé secrète : en production, générer une valeur aléatoire longue (python -c "import secrets; print(secrets.token_urlsafe(64))").
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
# 1 = mode debug (développement) ; 0 = production.
DJANGO_DEBUG=1
# Hôtes autorisés, séparés par des virgules.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Limite de débit des requêtes anonymes (facultatif).
THROTTLE_ANON=60/min
# Nombre de workers gunicorn (conteneur web).
GUNICORN_WORKERS=3
# Port publié sur la machine hôte par docker compose.
WEB_PORT=8000

# --- Base de données (utilisées par Django) ---
DB_NAME=komersia
# Hôte : "db" sous docker compose (surchargé par le compose) ; "localhost" hors Docker.
DB_HOST=localhost
DB_PORT=5432
# Rôle applicatif (non propriétaire, soumis à la RLS) : utilisé par le service web.
DB_USER=komersia_app
DB_PASSWORD=dev-app-password
# Rôle propriétaire : utilisé UNIQUEMENT pour les migrations et les tests.
DB_OWNER_USER=komersia_owner
DB_OWNER_PASSWORD=dev-owner-password

# --- Conteneur PostgreSQL (docker compose) ---
# Super-utilisateur du serveur PostgreSQL (initialisation uniquement).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev-postgres-password
# Port publié sur l'hôte (5433 pour ne pas entrer en conflit avec un PostgreSQL local).
DB_PUBLISHED_PORT=5433

# --- Sauvegarde / restauration (scripts/backup.sh, scripts/restore.sh) ---
# Rôle de sauvegarde : lecture seule, attribut BYPASSRLS (nécessaire car les tables utilisent FORCE RLS).
BACKUP_DB_USER=komersia_backup
BACKUP_DB_PASSWORD=dev-backup-password
# Rôle de restauration (crée la base cible) : le propriétaire.
RESTORE_DB_USER=komersia_owner
RESTORE_DB_PASSWORD=dev-owner-password
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
